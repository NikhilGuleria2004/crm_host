# Environment
# APP_ENV determines environment-specific behavior:
# - local: development on your machine
# - preview: Vercel preview deployments (branch PRs)
# - production: Vercel production deployment
APP_ENV=local
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/crm
MONGODB_DATABASE=crm

# Security
# SESSION_SECRET must be at least 32 characters in non-local environments
SESSION_SECRET=replace-with-at-least-32-random-chars
COOKIE_DOMAIN=localhost
CORS_ORIGIN=http://localhost:5173

# Environment-specific notes:
# - local:
#     COOKIE_DOMAIN=localhost
#     CORS_ORIGIN=http://localhost:5173
#     SESSION_SECRET >= 32 chars recommended
# - preview:
#     COOKIE_DOMAIN=.vercel.app
#     CORS_ORIGIN=https://<your-preview-branch>.vercel.app
#     SESSION_SECRET >= 32 chars required
# - production:
#     COOKIE_DOMAIN=<your-custom-domain>
#     CORS_ORIGIN=https://<your-custom-domain>
#     SESSION_SECRET >= 32 chars required
#
# Never commit .env files containing real values
