{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@crm/shared": ["../../packages/shared/src"],
      "@crm/config": ["../../packages/config/src"]
    },
    "noEmit": false
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
