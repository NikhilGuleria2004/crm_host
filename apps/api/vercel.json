{
  "version": 2,
  "builds": [
    {
      "src": "src/vercel.ts",
      "use": "@vercel/node"
    },
    {
      "src": "src/queue/cron.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/vercel.ts"
    },
    {
      "src": "/api/cron/queue",
      "dest": "src/queue/cron.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/queue",
      "schedule": "0 0 * * *"
    }
  ]
}