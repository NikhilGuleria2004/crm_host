{
  "name": "@crm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext ts --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:backup": "tsx src/scripts/backup.ts",
    "db:restore": "tsx src/scripts/restore.ts",
    "db:ensure-indexes": "tsx src/scripts/ensure-indexes.ts"
  },
  "dependencies": {
    "@crm/shared": "workspace:*",
    "hono": "^4.6.10",
    "@hono/node-server": "^1.13.7",
    "mongodb": "^6.9.0",
    "zod": "^3.23.8",
    "dotenv": "^16.4.7",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "bcrypt": "^5.1.1",
    "argon2": "^0.40.3",
    "@vercel/blob": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/bcrypt": "^5.0.2",
    "typescript": "~5.6.2",
    "tsx": "^4.19.2",
    "tsc-alias": "^1.8.10",
    "eslint": "^9.15.0",
    "vitest": "^2.1.6"
  }
}
