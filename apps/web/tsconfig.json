{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@crm/shared": ["../../packages/shared/src"],
      "@crm/ui": ["../../packages/ui/src"],
      "@crm/config": ["../../packages/config/src"]
    },
    "noEmit": false,
    "jsx": "react-jsx"
  },
  "include": ["src"]
}
